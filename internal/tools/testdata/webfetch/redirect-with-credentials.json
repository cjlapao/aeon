{
  "description": "a Location carrying user info is refused outright",
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "http://docs.test/cred",
        "header": {
          "Accept": [
            "text/plain, text/markdown, application/json, application/xml"
          ],
          "User-Agent": [
            "aeon-webfetch/1.0 (Aeon daemon; GET-only; sends no credentials)"
          ]
        }
      },
      "response": {
        "status": 302,
        "header": {
          "Location": [
            "http://user:***@docs.test/cred"
          ]
        },
        "body": ""
      }
    }
  ]
}
