{
  "description": "a lying Content-Length cannot shrink the reported size",
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "http://docs.test/understated",
        "header": {
          "Accept": [
            "text/plain, text/markdown, application/json, application/xml"
          ],
          "User-Agent": [
            "aeon-webfetch/1.0 (Aeon daemon; GET-only; sends no credentials)"
          ]
        }
      },
      "response": {
        "status": 200,
        "header": {
          "Content-Type": [
            "text/plain"
          ]
        },
        "body": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "content_length": 5
      }
    }
  ]
}
