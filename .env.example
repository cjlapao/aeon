# Aeon — local configuration
#
# Copy to .env for local development. .env is gitignored.
#
# NEVER put a credential in a config file, in argv, or in a log (C17). A value
# on a command line is in the process list and in shell history, and that
# failure is silent. Provider keys come from the environment or from a path to a
# file — never from a flag value.

# ── Nothing here is required ─────────────────────────────────────────────────
#
# `aeon serve` works on a clean machine with no .env at all: the signing key is
# generated on first run and the endpoint is enabled by a code-level pin. This
# file is for overriding, not for getting started.

# ── The cursor signing key ───────────────────────────────────────────────────
#
# REQUIRED by the framework (v0.10.1+) — without it the config service fails
# validation and the daemon does not start.
#
# Aeon generates one on first run at <store dir>/cursor.key, mode 0600, and
# leaves it alone forever after. Set this ONLY to supply your own, e.g. from a
# vault; an explicit value always wins and nothing is written to disk.
#
# It must stay STABLE across restarts: it signs pagination cursors, and rotating
# it invalidates every cursor already handed out.
#   Generate: openssl rand -hex 32
# CURSOR_SIGNING_KEY=

# ── The local endpoint (framework/localrpc) ──────────────────────────────────

# NOT a setting any more. localrpc is ForceOn in bootstrap.Pins(), because a
# daemon with no endpoint starts, reports healthy and can never be spoken to.
# Configuration cannot turn it off.
# LOCALRPC_ENABLED  (ignored — pinned on in code)

# Explicit endpoint path. Empty resolves it per-platform from the namespace
# below. NOTE: localhost chmods the endpoint's PARENT DIRECTORY to 0700, so the
# path must be somewhere you own — /tmp/aeon.sock fails, /tmp/aeon/aeon.sock
# works.
# LOCALRPC_ENDPOINT_PATH=

# Keeps two apps on one host from colliding. internal/appenv sets this to `aeon`
# in code when unset — without it the endpoint resolves under the FRAMEWORK's
# namespace (/run/user/<uid>/go-backend-scaffolding/rpc.sock), naming the wrong
# product.
# LOCALRPC_APP_NAMESPACE=aeon

# Reaching the limit refuses new connections with a defined error rather than
# queueing — a queue here would turn a client bug into a daemon that appears hung.
# LOCALRPC_MAX_CONNECTIONS=64

# Everything on this socket comes from another process.
# LOCALRPC_MAX_FRAME_BYTES=1048576

# Per-connection notification queue depth. On overflow the OLDEST notification
# is dropped and the sequence number still advances — so a consumer detects the
# gap and re-reads, rather than silently believing it saw everything.
# LOCALRPC_NOTIFY_BUFFER=256

# ── The narrow HTTP surface (framework/api) ──────────────────────────────────
#
# REGISTERED BUT PINNED OFF (ForceOff in bootstrap.Pins()). The framework
# defaults it to Enabled:true on :8080; the pin means CONFIGURATION CANNOT TURN
# IT ON — which is stronger than S19's N15 asked for.
#
# S19 removes the pin, together with the explicit-address and API-key
# requirements that make binding deliberate. Until then these do nothing.
# SERVER_API_ENABLED=false
# SERVER_API_PORT=8080
# SERVER_API_BIND_ADDRESS=localhost
